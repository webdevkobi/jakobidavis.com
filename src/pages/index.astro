---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";

const title = "Jakobi Davis, energy systems engineer";
const description =
  "Energy systems engineer, author, and founder. Capacity expansion, storage economics, and life cycle assessment from Cornell, plus a carbon price model.";
---

<Base title={title} description={description} bareTitle>
  <section class="hero">
    <div class="wrap hero-inner">
      <h1 class="hero-head">
        The next question won&rsquo;t be how to power it. It&rsquo;ll be which
        renewable to build it with.
      </h1>

      <div class="hero-copy">
        <div class="subhead-row">
          <p class="lede subhead">
            I study the energy transition one piece at a time: the policy, the
            money, and whether it can actually get built. Where I want this to
            go is renewables so modular that anything new, a data center or a
            new business, just plugs into them.
          </p>
          {/* The one handwritten note on this page. */}
          <p class="hand note-work" aria-hidden="true">
            <svg width="30" height="26" viewBox="0 0 30 26" fill="none" aria-hidden="true">
              <path
                d="M28 23C21 23 11.5 20 6 13.5 4.2 11.4 3 8.6 2.5 5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
              <path
                d="M2.5 5 1.5 11M2.5 5l5 2.2"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
            <span>this is the work</span>
          </p>
        </div>

        <figure class="bento green finding">
          <p class="label">The finding</p>
          <blockquote>
            <p>
              <span class="figure-num">$55</span> a ton gets New York to 70%
              renewables in an average year. Guaranteeing it takes{" "}
              <span class="figure-num">$120</span>.
            </p>
          </blockquote>
          <figcaption class="meta">
            CEE 4880 capstone, NYISO capacity expansion under a carbon tax
          </figcaption>
        </figure>

        <div class="btn-row hero-actions">
          <a class="btn solid act-projects" href="/projects/">Projects</a>
          <a class="btn act-resume" href="/resume/">Resume</a>
          <a class="btn act-book" href={site.calcomDiscovery} rel="noopener">
            Book a call
          </a>
        </div>
      </div>

      {/* The cutout stands in a sage panel that covers its bottom three
          quarters, so the crop at the legs reads as the edge of the panel.
          Head and shoulders clear the top of the panel onto bare paper. */}
      <div class="hero-photo">
        <div class="hero-stage">
          <div class="hero-panel" aria-hidden="true"></div>
          <img
            src="/images/hero-cutout.webp"
            alt="Jakobi Davis speaking on stage"
            width="778"
            height="1164"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section plain">
    <div class="wrap">
      <div class="bento intro-bento" data-reveal>
        <p class="eyebrow">Energy systems engineer</p>
        <h2>What I spend my time on.</h2>
      </div>

      <div class="work-grid">
        <a class="bento green work-card is-wide" href="/projects/" data-reveal>
          <p class="label">Energy systems</p>
          <h3>Five projects, real numbers.</h3>
          <p class="summary">
            Capacity expansion, battery economics, pumped storage, life cycle
            assessment, and solar for vertical farming. Each page shows what I
            found and where the answer stops holding up.
          </p>
          <p class="go">All five projects</p>
        </a>

        <a class="bento work-card" href="/models/" data-reveal>
          <p class="label">Models you can run</p>
          <h3>Move the carbon price yourself.</h3>
          <p class="summary">
            This slider runs on my capstone results. Drag it and watch what
            happens to New York&rsquo;s grid.
          </p>
          <p class="go">Open the model</p>
        </a>

        <a class="bento work-card" href="/writing/" data-reveal>
          <p class="label">Writing and speaking</p>
          <h3>A book and a few stages.</h3>
          <p class="summary">
            I wrote The Student-Athlete Playbook, and I spoke for Cornell
            Engineering&rsquo;s graduating class.
          </p>
          <p class="go">Writing and speaking</p>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The hero sits on bare graph paper. No box behind the words; its only
     bentos are the finding and the photo. Padding matches the bento gutter
     plus the bento padding below, so the headline lines up with the headings
     in the boxes. */
  .hero { padding-inline: var(--gutter); }
  .hero-inner {
    --hero-pb: clamp(32px, 5vw, 56px);
    display: grid;
    gap: clamp(28px, 4vw, 44px);
    padding-inline: var(--bento-pad);
    padding-top: clamp(32px, 5vw, 60px);
    padding-bottom: var(--hero-pb);
  }
  /* The headline runs the full width so it lands on two lines, then the copy
     and the photo split the row underneath it. */
  @media (min-width: 920px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      grid-template-areas:
        "head head"
        "copy photo";
      column-gap: clamp(40px, 5vw, 64px);
      align-items: end;
    }
    .hero-head { grid-area: head; }
    .hero-copy { grid-area: copy; }
    .hero-photo { grid-area: photo; }
  }

  /* Sized so the sentence breaks into two lines at the wrap width. */
  .hero-head {
    margin: 0;
    font-size: clamp(2.05rem, 1rem + 3.5vw, 3rem);
    line-height: 1.1;
  }

  /* The handwritten note sits in the margin beside the subhead on desktop,
     and tucks under it on phones. */
  .subhead-row {
    display: grid;
    gap: 10px 18px;
    margin-bottom: clamp(26px, 4vw, 38px);
  }
  @media (min-width: 640px) {
    .subhead-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
  .subhead { margin: 0; max-width: 60ch; }
  .note-work { margin: 0; align-self: end; }
  .note-work svg { transform: scaleX(-1); }
  @media (min-width: 640px) {
    .note-work svg { transform: none; }
  }

  /* The capstone finding is the hero callout, and it is a renewable energy
     finding, so it gets the forest bento. */
  .finding {
    margin: 0 0 clamp(26px, 4vw, 36px);
    max-width: 42ch;
  }
  .finding blockquote { margin: 0.7em 0 0; }
  .finding blockquote p {
    font-family: var(--display);
    font-size: clamp(1.3rem, 1rem + 1.5vw, 1.9rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--on-dark);
    text-wrap: balance;
  }
  .finding .figure-num { font-size: 1.18em; }
  .finding figcaption { margin-top: 16px; }

  /* The photo column bottom lines up with the button row on the left, which
     the grid handles with align-items: end. */
  .hero-photo {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  /* The stage is exactly the image box. Rounding only the bottom corners and
     hiding overflow clips the photo to the panel's bottom edge, while leaving
     the head and shoulders free to rise above the panel's top. */
  .hero-stage {
    position: relative;
    width: 100%;
    max-width: 300px;
    overflow: hidden;
    border-radius: 0 0 var(--r) var(--r);
  }
  .hero-panel {
    position: absolute;
    inset: auto 0 0 0;
    height: 75%;
    border-radius: var(--r);
    background: var(--green);
  }
  .hero-stage img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
  }
  @media (min-width: 920px) {
    .hero-photo { justify-content: flex-end; }
    .hero-stage { max-width: min(100%, 430px); }
  }

  /* Phones: the photo comes second, straight under the headline, because at
     the bottom of the column it sat about 1,100px down and most visitors
     never got to it. The copy, the finding and the buttons follow. */
  @media (max-width: 768px) {
    .hero-inner {
      grid-template-areas:
        "head"
        "photo"
        "copy";
    }
    .hero-head { grid-area: head; }
    .hero-photo { grid-area: photo; }
    .hero-copy { grid-area: copy; }

    /* The panel runs the full content width and the stage is fixed at 320px
       tall, so the cutout is sized by height instead of width: head and
       shoulders still clear the top of the panel, legs still crop on its
       bottom edge. */
    .hero-stage {
      max-width: 100%;
      height: 320px;
    }
    .hero-stage img {
      width: auto;
      height: 100%;
      margin-inline: auto;
    }

    /* Three full-width buttons, the call first: on a phone booking is the
       action worth leading with, so it takes the solid weight here. */
    .hero-actions {
      flex-direction: column;
      gap: 12px;
    }
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
    .hero-actions .act-book {
      order: -1;
      background: var(--ink);
      border-color: var(--ink);
      color: #fff;
    }
    .hero-actions .act-projects {
      background: transparent;
      border-color: var(--ink);
      color: var(--ink);
    }
  }

  /* The work bento grid: mixed sizes on desktop, one column on phones. */
  .intro-bento { margin-bottom: clamp(14px, 2vw, 22px); }
  .intro-bento h2 { margin: 0; max-width: 20ch; }

  .work-grid {
    display: grid;
    gap: clamp(14px, 2vw, 22px);
  }
  @media (min-width: 820px) {
    .work-grid { grid-template-columns: repeat(2, 1fr); }
    .work-grid .is-wide { grid-row: span 2; }
  }

  .work-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0;
    align-content: start;
  }
  .work-card h3 { margin: 12px 0 0.6em; }
  .work-card .summary { color: var(--ink-2); }
  .work-card.green .summary { color: var(--on-dark-2); }
  .work-card .go {
    margin-top: 22px;
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--forest);
  }
  .work-card .go::after { content: " \2192"; }
  /* Brand green is 3.3:1 on forest, too low for an 11px label, so the link
     line on the forest card is white. */
  .work-card.green .go { color: var(--on-dark); }
  .work-card.is-wide h3 {
    font-size: var(--step-3);
    max-width: 22ch;
  }
</style>
