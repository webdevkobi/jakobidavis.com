---
import Base from "../layouts/Base.astro";

// Edit this content freely. Everything on the page pulls from here.
const lanes = [
  {
    tag: "Engineer",
    title: "Civil engineering, renewable energy",
    body: "Cornell Civil Engineering graduate focused on renewable energy systems. FE-certified, Dean's List, after starting freshman year with a 2.7 GPA.",
  },
  {
    tag: "Athlete",
    title: "Division I captain to pro ball",
    body: "Four-year starter and two-year captain at Cornell. Holds the program's career strikeout record. Pitched in the MLB Draft League and the Frontier League.",
  },
  {
    tag: "Founder",
    title: "Champions Voice",
    body: "Building systems that help student-athletes ages 15 to 25 win in the classroom, in recruiting, and in life.",
  },
];

const highlights = [
  { stat: "#1", label: "Cornell career strikeouts" },
  { stat: "2x", label: "Team captain" },
  { stat: "FE", label: "Certified engineer-in-training" },
  { stat: "52", label: "Countries visited" },
];

const projects = [
  {
    name: "Champions Voice",
    blurb: "Academic, recruiting, and life systems for student-athletes.",
    href: "#",
  },
  {
    name: "The Student Athlete Playbook",
    blurb: "A book on building the habits that carry athletes past their playing days.",
    href: "#",
  },
  {
    name: "Engineering work",
    blurb: "Renewable energy capstone and selected technical projects. Add case studies here.",
    href: "#",
  },
];
---

<Base>
  <header class="nav wrap">
    <a href="/" class="logo">Jakobi Davis</a>
    <nav>
      <a href="#about">About</a>
      <a href="#work">Work</a>
      <a href="#speaking">Speaking</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <div class="hero wrap">
      <p class="eyebrow">Engineer · Athlete · Founder</p>
      <h1>I build systems that help people perform.</h1>
      <p class="lede">
        Cornell engineer, former professional pitcher, and founder of Champions Voice.
        Based in Atlanta.
      </p>
      <div class="cta">
        <a class="btn primary" href="#contact">Get in touch</a>
        <a class="btn" href="#work">See the work</a>
      </div>
    </div>

    <section id="about">
      <div class="wrap">
        <p class="eyebrow">About</p>
        <h2>Three lanes, one standard.</h2>
        <div class="grid three">
          {lanes.map((l) => (
            <article class="card">
              <p class="tag">{l.tag}</p>
              <h3>{l.title}</h3>
              <p>{l.body}</p>
            </article>
          ))}
        </div>
        <div class="stats">
          {highlights.map((h) => (
            <div>
              <strong>{h.stat}</strong>
              <span>{h.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="work">
      <div class="wrap">
        <p class="eyebrow">Work</p>
        <h2>What I'm building.</h2>
        <div class="grid three">
          {projects.map((p) => (
            <a class="card link" href={p.href}>
              <h3>{p.name}</h3>
              <p>{p.blurb}</p>
              <span class="arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="speaking">
      <div class="wrap split">
        <div>
          <p class="eyebrow">Speaking</p>
          <h2>From a 2.7 GPA to class speaker.</h2>
        </div>
        <div>
          <p>
            Graduating class speaker for Cornell Engineering and Cornell Peer Mentor of the Year.
            I speak to students, athletes, and schools about building systems that hold up
            under pressure.
          </p>
          <a class="btn primary" href="#contact">Book a talk</a>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="wrap">
        <p class="eyebrow">Contact</p>
        <h2>Let's talk.</h2>
        <p class="lede">
          <a href="mailto:hello@jakobidavis.com">hello@jakobidavis.com</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <p>© {new Date().getFullYear()} Jakobi Davis</p>
  </footer>
</Base>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 24px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .logo { font-family: var(--serif); font-weight: 700; font-size: 1.2rem; text-decoration: none; }
  nav { display: flex; gap: 22px; flex-wrap: wrap; }
  nav a { text-decoration: none; color: var(--ink-soft); font-weight: 500; font-size: 0.95rem; }
  nav a:hover { color: var(--gold); }

  .hero { padding-top: 96px; padding-bottom: 112px; }
  .hero h1 { max-width: 15ch; }
  .lede { font-size: 1.2rem; color: var(--ink-soft); max-width: 52ch; }
  .cta { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }

  .btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .btn.primary { background: var(--gold); border-color: var(--gold); color: #0f1a2b; }
  .btn:hover { transform: translateY(-1px); }

  .grid { display: grid; gap: 20px; margin-top: 36px; }
  .three { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    position: relative;
  }
  .card p { color: var(--ink-soft); margin: 0; }
  .card.link { text-decoration: none; transition: border-color 0.2s; }
  .card.link:hover { border-color: var(--gold); }
  .card.link h3 { padding-right: 24px; }
  .arrow { position: absolute; top: 24px; right: 24px; color: var(--gold); }
  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold) !important;
    margin-bottom: 12px !important;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
    margin-top: 56px;
  }
  .stats strong { display: block; font-family: var(--serif); font-size: 2.6rem; color: var(--gold); }
  .stats span { color: var(--ink-soft); font-size: 0.95rem; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .split p { color: var(--ink-soft); margin-top: 0; }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; gap: 8px; } }

  footer { padding-top: 32px; padding-bottom: 48px; color: var(--ink-soft); font-size: 0.9rem; }
</style>
