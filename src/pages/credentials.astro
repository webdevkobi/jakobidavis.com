---
import Base from "../layouts/Base.astro";

const title = "Credentials";
const description =
  "Cornell BS in Civil Engineering with a Sustainable Energy Systems minor, the Civil FE, Cornell Peer Mentor of the Year, and two Anthropic AI certifications.";

const groups = [
  {
    label: "Degree",
    items: [
      {
        title: "BS, Civil Engineering",
        detail:
          "Cornell University, May 2025. Minor in Sustainable Energy Systems.",
        href: null,
      },
    ],
  },
  {
    label: "Licensure",
    items: [
      {
        title: "Fundamentals of Engineering, Civil",
        detail: "Passed November 2025, NCEES. I hold the FE, not the PE.",
        href: null,
      },
    ],
  },
  {
    label: "Awards",
    items: [
      {
        title: "Peer Mentor of the Year",
        detail: "Cornell University.",
        href: null,
      },
    ],
  },
  {
    label: "Certifications",
    items: [
      {
        title: "AI Fluency: Framework and Foundations",
        detail: "Anthropic, June 2026.",
        href: "https://verify.skilljar.com/c/2e6wzys9yhym",
      },
      {
        title: "Claude 101",
        detail: "Anthropic, June 2026.",
        href: "https://verify.skilljar.com/c/svpqau37m94f",
      },
    ],
  },
];
---

<Base title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Credentials</p>
      <h1>Degree, license, and certifications.</h1>
      <p class="lede">
        The full list is on my <a href="/resume/">resume</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <div class="groups">
        {
          groups.map((group) => (
            <section class="group">
              <h2 class="file-kind">{group.label}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <h3>{item.title}</h3>
                    {item.detail.startsWith("TODO:") ? (
                      <p class="ph">{item.detail.replace(/^TODO:\s*/, "")}</p>
                    ) : (
                      <p>{item.detail}</p>
                    )}
                    {item.href && (
                      <p class="verify">
                        <a class="tap" href={item.href} rel="noopener">
                          Verify this certificate
                        </a>
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .groups {
    display: grid;
    gap: clamp(28px, 4vw, 44px);
    max-width: 62ch;
  }
  .group h2 { margin-bottom: 14px; }
  .group ul {
    display: grid;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
    padding-top: 18px;
  }
  .group h3 {
    font-size: var(--step-1);
    margin-bottom: 0.3em;
  }
  .group p { color: var(--ink-2); }
  .verify {
    margin-top: 0.4em;
    font-size: var(--step--1);
  }
</style>
