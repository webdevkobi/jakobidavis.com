---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";

const title = "Writing and Speaking";
const description =
  "The Student-Athlete Playbook, the graduating class address for Cornell Engineering, keynotes, and an interview with will.i.am at InstructureCon.";

// Items without a link carry no visible placeholder: the entry still reads as
// a finished line, and the link appears when there is one.
const items = [
  {
    kind: "Book",
    title: "The Student-Athlete Playbook",
    body: "The Student-Athlete Playbook is what I wish someone had handed me at eighteen: the systems that get you through school, recruiting, and life after your last game.",
    href: "https://championsvoice.org/products/student-athlete-playbook",
    linkLabel: "Get the book",
  },
  {
    kind: "Address",
    title: "Graduating class speaker, Cornell Engineering",
    body: "I was chosen to speak for Cornell Engineering's graduating class in May 2025.",
    href: null,
    linkLabel: null,
  },
  {
    kind: "Keynotes",
    title: "Keynotes",
    body: "I talk to students, athletes, and schools about building systems that hold up when things get hard.",
    href: site.calcomDiscovery,
    linkLabel: "Book me to speak",
  },
  {
    kind: "Interview",
    title: "Interview with will.i.am at InstructureCon",
    body: "At InstructureCon 2021, I interviewed will.i.am on stage about his STEAM work.",
    href: "https://www.youtube.com/watch?v=HgB1L_NKGlY&t=1218s",
    linkLabel: "Watch the interview",
  },
];
---

<Base title={title} description={description}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Book, speeches, interview</p>
      <h1>What I&rsquo;ve written and where I&rsquo;ve spoken.</h1>
      <p class="lede">
        A book, a commencement speech, keynotes, and a conversation with
        will.i.am.
      </p>
    </div>
  </section>

  <section class="section plain">
    <div class="wrap">
      <ul class="items">
        {
          items.map((item) => (
            <li class="bento" data-reveal>
              <p class="file-kind">{item.kind}</p>
              <h2>{item.title}</h2>
              <p class="body">{item.body}</p>
              {item.href && (
                <p class="go">
                  <a class="tap" href={item.href} rel="noopener">
                    {item.linkLabel}
                  </a>
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-reveal>
      <h2>Want me to speak?</h2>
      <p class="prose">
        <a href={site.calcomDiscovery} rel="noopener">Book a discovery call</a>,
        or reach out on the <a href="/contact/">contact page</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .items {
    display: grid;
    gap: clamp(14px, 2vw, 22px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 760px) {
    .items { grid-template-columns: repeat(6, 1fr); }
    .items > li { grid-column: span 3; }
    /* The book leads, so it takes the wide box. */
    .items > li:first-child { grid-column: span 6; }
    .items > li:nth-child(2) { grid-column: span 4; }
    .items > li:nth-child(3) { grid-column: span 2; }
  }
  .items h2 {
    font-size: var(--step-2);
    margin: 10px 0 0.5em;
  }
  .body { color: var(--ink-2); }
  .go { margin-top: 1.2em; font-weight: 500; }
</style>
