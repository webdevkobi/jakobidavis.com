---
import { isTodo } from "../lib/placeholders";

interface Props {
  index: number;
  href: string;
  course: string;
  title: string;
  result: string;
  summary: string;
  tools: string[];
}

const { index, href, course, title, result, summary, tools } = Astro.props;
const indexLabel = String(index).padStart(2, "0");

// A tool list that is still a TODO shows nothing here rather than a
// placeholder chip. The project page is where the unfilled fields are visible.
const shownTools = tools.filter((tool) => !isTodo(tool));
---

<a class="bento project-card" href={href}>
  <div class="card-head">
    <span class="num index" aria-hidden="true">{indexLabel}</span>
    <span class="file-kind">{course}</span>
  </div>

  <h3>{title}</h3>

  {/* The headline result is a renewable energy finding, so it rides on the
      forest panel. */}
  <div class="bento green result">
    <p class="label">What I found</p>
    <p class="result-line">{result}</p>
  </div>

  <p class="summary">{summary}</p>

  {
    shownTools.length > 0 && (
      <ul class="tools">
        {shownTools.map((tool) => <li class="meta">{tool}</li>)}
      </ul>
    )
  }
</a>

<style>
  .project-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    height: 100%;
  }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--rule);
  }
  .index {
    font-size: var(--step-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--forest);
  }
  .project-card h3 { margin-bottom: 0.7em; }

  /* A panel inside a bento, so it runs tighter than a standalone box. */
  .result {
    padding: clamp(18px, 2.2vw, 22px);
    border-radius: var(--r-sm);
    margin-bottom: 1.1em;
  }
  .result-line {
    margin: 0.5em 0 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--on-dark);
  }

  .summary { color: var(--ink-2); }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }
  .tools li {
    padding: 5px 12px;
    border: 1px solid var(--rule-strong);
    border-radius: 12px;
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
